{
  "name": "ss3o-jobdesk-system",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "postinstall": "node scripts/setup-env.js && node --env-file-if-exists=.env scripts/seed.js",
    "predev": "node --env-file-if-exists=.env scripts/seed.js",
    "dev": "next dev",
    "prestart": "node --env-file-if-exists=.env scripts/seed.js",
    "start": "next dev",
