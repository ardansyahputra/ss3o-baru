    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "autoprefixer": "^10.4.19",
    "postcss": "^8.4.38",
    "tailwindcss": "^3.4.4",
    "@opennextjs/cloudflare": "^1.20.13",
    "wrangler": "^4.148.0"
  }
}
