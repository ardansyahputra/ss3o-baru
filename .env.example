# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="ganti-dengan-random-string-yang-panjang"

# Upload
UPLOAD_MAX_SIZE_MB=5
UPLOAD_DIR="./public/uploads"

# Catatan: secara default (tanpa variabel di bawah), data disimpan sebagai
# file JSON di folder data/ dan file upload di public/uploads — cocok untuk
# development lokal, TIDAK cocok untuk deploy ke Vercel (filesystem-nya
# read-only & sementara).
#
# Untuk deploy ke Vercel, sambungkan Postgres & Blob dari dashboard Vercel
# (Storage → Create Database / Create Blob Store). Vercel akan otomatis
# meng-inject variabel di bawah ini ke environment production — TIDAK perlu
# diisi manual satu-satu:
#   POSTGRES_URL=...            (dari Vercel Postgres / Neon)
#   BLOB_READ_WRITE_TOKEN=...   (dari Vercel Blob)

# Retensi bukti upload — Vercel Cron (lihat vercel.json) memanggil
# /api/cron/purge-uploads tiap hari jam 03:00 WIB, tapi baru BENERAN
# menghapus kalau sudah 8 hari sejak terakhir dihapus. Opsional: isi
# CRON_SECRET (string acak bebas) supaya endpoint ini menolak pemanggilan
# dari luar Vercel. Kalau diisi, tambahkan juga nilai yang sama persis di
# Environment Variables project Vercel-mu.
# CRON_SECRET="ganti-dengan-random-string"
