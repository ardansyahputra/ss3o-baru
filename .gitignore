# Dependencies
/node_modules

# Next.js build output
/.next
/out

# Env files — JANGAN pernah di-commit, isinya token/password database & blob
.env
.env.local
.env.*.local
!.env.example

# File upload lokal (dev tanpa Blob) — jangan commit hasil upload staff.
# Catatan: data/*.json SENGAJA TIDAK di-gitignore — file itu snapshot seed
# (lihat lib/seed.js), harus tetap ke-commit supaya deploy baru/database
# kosong ada sumber data buat di-seed ulang.
/public/uploads

# Misc
.DS_Store
*.log
npm-debug.log*
